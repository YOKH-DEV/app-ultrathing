{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ultrathing",
  "version": "0.1.0",
  "identifier": "com.ultrathing.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      { "title": "Ultrathing", "width": 1280, "height": 800, "minWidth": 1024 }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ultrathing-engine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
