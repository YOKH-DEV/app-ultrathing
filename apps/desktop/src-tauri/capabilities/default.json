{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://vgtwylbmefujgvhsgrre.supabase.co/auth/v1/authorize?*"
        }
      ]
    },
    "opener:allow-open-path",
    "clipboard-manager:allow-read-image",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**"]
    }
  ]
}
